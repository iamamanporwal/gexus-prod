# Authentication has been removed from this fork — the app always runs as the
# single local identity in shared/localUser.ts. There are no auth-related keys
# (no SSO provider, no account URL, no account-purge secret) and no sign-in.
#
# WARNING: RLS is disabled on every table, so the anon key below grants full
# read/write. Keep this deployment local.
VITE_SUPABASE_ANON_KEY="<Local Anon Key from `npx supabase start`>"
VITE_SUPABASE_URL='http://127.0.0.1:54321'
SUPABASE_SERVICE_ROLE_KEY="<Local Service Role Key from `npx supabase start`>"
VITE_POSTHOG_PROJECT_KEY="<Test PostHog Project Key>"
VITE_SENTRY_ENVIRONMENT="local"
VITE_SENTRY_DSN="<Sentry DSN>"
ANTHROPIC_API_KEY="<Test Anthropic API Key>"
OPENROUTER_API_KEY="<Test OpenRouter API Key>"
OPENAI_API_KEY="<Test OpenAI API Key>"
GOOGLE_API_KEY="<Test Google API Key>"
FAL_KEY="<Test FAL API Key>"
# Billing is bypassed entirely while ENVIRONMENT="local" (see
# src/server/billingClient.ts), so these two can stay as-is locally.
BILLING_SERVICE_URL="<Test Billing Service URL>"
BILLING_SERVICE_KEY="<Test Billing Service Key>"
ENVIRONMENT="local"
ADAM_URL="<Adam URL or dev URL>"
WEBHOOK_BASE_URL="<Public TanStack App URL>"
NGROK_URL="<NGROK URL>"
